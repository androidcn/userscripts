#!name=  VVebo Loon专用
#!desc=修复VVebo用户主页时间线显示和粉丝列表 @androidcn适配
#!author=suiyuran
#!icon = http://www.kkx.net/uploadfile/2023/0302/20230302170522851.png
#!openUrl = https://apps.apple.com/app/id670910957
[Script]
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/remind\/unread_count\?/i then script("https://raw.githubusercontent.com/suiyuran/stash/main/scripts/fix-vvebo-user-timeline.js") with tag="修复时间线1"
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/user_timeline\?/i then script("https://raw.githubusercontent.com/suiyuran/stash/main/scripts/fix-vvebo-user-timeline.js") with tag="修复时间线2"
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/profile\/statuses\/tab\?/i then script("https://raw.githubusercontent.com/suiyuran/stash/main/scripts/fix-vvebo-user-timeline.js") with tag="修复时间线3", requires_body=true
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/cardlist\?/i then script("https://raw.githubusercontent.com/suiyuran/stash/main/scripts/fix-vvebo-fans.js") with tag="修复「我的」页面", requires_body=true

[MITM]

hostname = %APPEND% api.weibo.cn
