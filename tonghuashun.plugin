[Script]
response if ${url} ~= /^https:\/\/recommend\.10jqka\.com\.cn\/app\/discover\/api\/v1\/recommend/i then script("https://raw.githubusercontent.com/androidcn/userscripts/main/tonghuashun.js") with tag="THSblockAD", timeout=60, requires_body=true
png

[Rewrite]
#同花顺
request if ${url} ~= /^https?:\/\/adm\.10jqka\.com\.cn\/interface\/ad\/recommend/i then reject(404)
request if ${url} ~= /^https:\/\/c\.10jqka\.com\.cn\/lgt\/common2c\/auth\/api\/ad_recommend\/v1\/comment_ad_recommend/i then reject_dict(200)

[MITM]
hostname = recommend.10jqka.com.cn,c.10jqka.com.cn
